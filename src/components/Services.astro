---

<section id="services" class="section-y border-y border-white/[0.06] bg-gradient-to-b from-white/[0.02] to-transparent">
  <div class="container-zen">
    <div class="max-w-3xl">
      <p class="eyebrow text-emerald-200/60">Services</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">What we deliver</h2>
      <p class="mt-4 text-lg leading-relaxed text-zinc-400">
        Two practice areas—technology you can run and support your customers can trust. Each item below is work we staff,
        measure, and improve with you.
      </p>
    </div>

    {
      groups.map((group, groupIndex) => (
        <div class:list={['mt-14', groupIndex > 0 && 'mt-20 border-t border-white/[0.06] pt-20']}>
          <div class="max-w-3xl">
            <h3 class="font-display text-2xl font-semibold text-white sm:text-[1.65rem]">{group.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-zinc-400">{group.intro}</p>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item) => (
              <article class="surface group relative overflow-hidden p-7 lg:p-8">
                <div
                  class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full bg-gradient-to-br from-violet-500/15 to-transparent opacity-0 blur-2xl transition group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="mb-5 inline-flex rounded-xl bg-white/[0.06] p-3 ring-1 ring-white/10">
                  <svg class="h-7 w-7 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={item.icon} />
                  </svg>
                </div>
                <h4 class="font-display text-lg font-semibold text-white">{item.title}</h4>
                <p class="mt-2 text-sm leading-relaxed text-zinc-400">{item.body}</p>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
