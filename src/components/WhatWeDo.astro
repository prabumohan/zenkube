---
const pillars = [
  {
    title: 'IT services',
    body: 'Network, security, cloud, help desk, consultation, and custom software—built to keep your operations secure and running.',
  },
  {
    title: 'Call centre',
    body: 'Inbound and outbound lines, chat and email, campaign outreach, QA scorecards, and ops reporting—run to your playbooks.',
  },
  {
    title: 'Partnership',
    body: 'We align technology and customer operations with your business goals—not one-off fixes without a roadmap.',
  },
];

const audiences = [
  'Businesses modernizing IT infrastructure and cloud',
  'Teams that need 24/7 help desk and network support',
  'Brands scaling inbound, outbound, and multi-channel customer service',
];
---

<section id="what-we-do" class="section-y border-b border-white/[0.06] bg-white/[0.015]">
  <div class="container-zen">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-10">
      <div class="lg:col-span-5">
        <p class="eyebrow text-emerald-200/60">What we do</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          IT and customer operations, delivered end to end
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-400">
          ZenKube delivers <strong class="font-medium text-zinc-200">IT services and call centre operations</strong> for
          businesses that need reliable infrastructure and customer support at scale—from network and cloud work to inbound,
          outbound, and multi-channel contact centre teams.
        </p>
        <p class="mt-4 text-base leading-relaxed text-zinc-500">
          We scope engagements with clear deliverables and handover—whether that is a hardened network, a migrated cloud
          estate, or a contact centre queue with weekly quality reviews.
        </p>
      </div>

      <div class="lg:col-span-7">
        <ul class="grid gap-4 sm:grid-cols-3">
          {
            pillars.map((pillar) => (
              <li class="surface-muted h-full p-6">
                <p class="font-display text-lg font-semibold text-white">{pillar.title}</p>
                <p class="mt-2 text-sm leading-relaxed text-zinc-500">{pillar.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="surface mt-4 p-6 sm:p-7">
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-500">Who we work with</p>
          <ul class="mt-4 space-y-2.5">
            {
              audiences.map((line) => (
                <li class="flex gap-3 text-sm leading-relaxed text-zinc-400">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400/80" aria-hidden="true" />
                  {line}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
